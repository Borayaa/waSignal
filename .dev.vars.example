# Local development environment variables.
# Copy to .dev.vars and fill in the values below.

# Session JWT signing key (generate with: openssl rand -base64 48)
SESSION_SECRET=your-session-secret-here-replace-with-random-48-char-base64

# Account API key encryption key (generate with: openssl rand -base64 32)
# CRITICAL: must be exactly 32 bytes base64; never change after accounts exist
ENCRYPTION_KEY=your-encryption-key-here-replace-with-random-32-byte-base64

# Bridge authentication token (generate with: openssl rand -hex 32)
BRIDGE_TOKEN=your-bridge-token-here-replace-with-random-64-char-hex

# Invite code required to create new dashboard accounts (optional; generate with: openssl rand -hex 6)
INVITE_CODE=your-invite-code

# cTrader Open API application (https://openapi.ctrader.com → Applications)
CTRADER_CLIENT_ID=your-ctrader-client-id
CTRADER_CLIENT_SECRET=your-ctrader-client-secret
